# ==================== ОБЯЗАТЕЛЬНО ====================

# Токен Telegram-бота. Получить: https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token

# ID чата администраторов техподдержки (целое число)
ADMIN_CHAT_ID=-1

# Секрет для подписи JWT.
# Сгенерировать:  python -c "import secrets; print(secrets.token_hex(32))"
#                 openssl rand -hex 32
JWT_SECRET=dev_secret_change_in_production_min_32_chars

# Пароль пользователя PostgreSQL
DB_PASSWORD=faunistica

# ==================== ОПЦИОНАЛЬНО ====================

# База данных PostgreSQL (значения по умолчанию — для разработки)
DB_NAME=faunistica
DB_HOST=localhost
DB_PORT=5432
DB_USER=faunistica

# Прокси для Telegram-бота: socks5://user:pass@host:port или http://host:port
BOT_PROXY=
# Имя пользователя бота (без @)
BOT_USERNAME=
# Включить бота (true/false, по умолчанию true)
BOT_ENABLED=true
# ID разработчика в Telegram (используется скриптом init)
DEV_TG_ID=

# Время жизни access-токена (минут, по умолчанию 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Время жизни refresh-токена (дней, по умолчанию 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING
# Логировать SQL-запросы (true/false)
DB_ECHO=false

# URL сайта (для ссылок в письмах и уведомлениях)
SITE_URL=https://faunistica.ru
# Разрешённые CORS-источники (через запятую)
ALLOWED_ORIGINS=

# ==================== PgAdmin (опционально) ====================
# Используется только при запуске: docker compose --profile tools up -d
# Открыть: http://localhost:8080
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
