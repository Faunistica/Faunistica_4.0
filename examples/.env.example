# BOT_TOKEN – токен Telegram-бота (обязательно)
# BOT_PROXY – опционально: socks5://user:pass@host:port или http://host:port
# ADMIN_CHAT_ID – ID чата администратора (обязательно)
BOT_TOKEN=
BOT_PROXY=
ADMIN_CHAT_ID=

# База данных PostgreSQL
# Для all-docker: DB_HOST=db
# Для hybrid: DB_HOST=/var/run/postgresql (сокет) или localhost (TCP)
DB_NAME=faunistica
DB_HOST=db
DB_PORT=5432
DB_USER=faunistica
DB_PASSWORD=faunistica

# JWT
JWT_SECRET=dev_secret_change_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Логирование
LOG_LEVEL=WARNING
DB_ECHO=false
