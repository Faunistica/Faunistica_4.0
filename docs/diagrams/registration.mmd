sequenceDiagram
    actor User
    participant Frontend as Frontend
    participant API as API
    participant Bot as Telegram Bot
    participant DB as PostgreSQL

    User->>Frontend: Click register
    Frontend->>API: POST /api/auth/code
    API->>DB: INSERT pending (code, AWAITING_CODE)
    API-->>Frontend: {code, token, bot_url}
    Frontend->>User: Show code, QR, deep link

    User->>Bot: Enter code in Telegram
    Bot->>DB: Lookup pending by code
    Bot->>DB: UPDATE status = AWAITING_API_REGISTRATION
    Bot-->>User: Registration confirmed!

    loop Poll every 1s
        Frontend->>API: GET /api/auth/code/status
        API-->>Frontend: {status: AWAITING_API_REGISTRATION}
    end

    Frontend->>User: Show onboarding form
    User->>Frontend: Fill: username, password, name,<br/>age, sex, lang, comm, rating, agreement
    Frontend->>API: POST /api/auth/survey
    API->>API: Hash password, create user
    API->>DB: reg_stat = REG_COMPLETED
    API->>API: Set JWT cookies
    API-->>Frontend: {status: COMPLETED}
    Frontend->>User: Redirect to /dashboard
