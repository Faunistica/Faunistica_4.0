flowchart LR
    subgraph Geo[Geocoding]
        G1[DMS: deg/min/sec]
        G2[dms_to_degrees]
        G3[GET /api/geo/reverse-geocode]
        G4[Nominatim reverse]
        G5[country region district]

        G1-->G2-->G3-->G4-->G5

        G6[GET /api/geo/search]
        G7[locations.json]
        G6-->G7
    end

    subgraph Taxon[Taxonomy]
        T1[GET /api/taxonomy/suggest]
        T2[GET /api/taxonomy/autofill]
        T3[species_export.csv]
        T1-->T3
        T2-->T3
    end

    Geo --> Form[Record form]
    Taxon --> Form
