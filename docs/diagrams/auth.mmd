flowchart LR
    subgraph Way1[Way 1: Login / Password]
        A1[User enters<br/>username + password]
        A2[POST /api/auth/login]
        A3[Validate password<br/>check reg_stat]
        A4[set_response_token_cookies<br/>access_token + refresh_token]
        A5[Redirect to /dashboard]

        A1-->A2-->A3-->A4-->A5
    end

    subgraph Way2[Way 2: Via Telegram]
        B1[User clicks<br/>Login via Telegram]
        B2[POST /api/auth/code]
        B3[Show code, QR,<br/>deep link]
        B4[User enters code in bot<br/>/confirm /start /register]
        B5{Bot finds<br/>existing user?}
        B6[set_response_token_cookies<br/>JWT]

        B1-->B2-->B3-->B4-->B5
        B5-->|Yes: AWAITING_API_LOGIN| B6
        B6-->B7[Frontend polls<br/>GET /api/auth/code/status]
        B7-->B8[Redirect to /dashboard]
    end

    Way1 --> R[User authenticated<br/>JWT cookies set]
    Way2 --> R
